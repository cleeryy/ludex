# Maintainer: cleeryy <clery.arqueferradou@gmail.com>
#
# Repackages the published Linux AppImage: the desktop app is a Tauri shell over
# WebKitGTK, so a source build would drag a full Rust + Node toolchain onto every
# user's machine. The digest below is the AppImage line from the release
# SHA256SUMS, checked by scripts/check-packaging.mjs in CI (never typed by hand).

pkgname=ludex-bin
pkgver=0.4.22
pkgrel=1
pkgdesc="DRM-free game library, launcher and save manager (published AppImage build)"
arch=('x86_64')
url="https://github.com/cleeryy/ludex"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
provides=('ludex')
conflicts=('ludex')
# `!strip`: the AppImage is a signed, prebuilt runtime, not a binary to rewrite.
# `!debug`: no symbols exist for it, and the empty /usr/src/debug tree otherwise
# trips namcap.
options=(!strip !debug)
source=(
  "Ludex_${pkgver}_amd64.AppImage::${url}/releases/download/v${pkgver}/Ludex_${pkgver}_amd64.AppImage"
  "ludex.png::${url}/raw/v${pkgver}/apps/desktop/src-tauri/icons/icon.png"
)
sha256sums=(
  'bc6b32ab2705f73458b4014eabe0a4e13e9f9551aca77a986b93ebcb84b5940a'
  '9d4cf2c2d825afc99ea45d4787dd3ed41465d82805804244e1cff0e380292c8a'
)

package() {
  install -d "$pkgdir/opt/ludex" "$pkgdir/usr/bin" \
    "$pkgdir/usr/share/applications" "$pkgdir/usr/share/icons/hicolor/512x512/apps"

  install -Dm755 "Ludex_${pkgver}_amd64.AppImage" "$pkgdir/opt/ludex/ludex.AppImage"
  install -Dm644 ludex.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ludex.png"

  # Arch ships no FUSE 2 by default, so the AppImage is never mounted: the
  # runtime unpacks itself into a temporary folder and runs from there.
  cat > "$pkgdir/usr/bin/ludex" <<'EOF'
#!/bin/sh
exec /opt/ludex/ludex.AppImage --appimage-extract-and-run "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/ludex"

  cat > "$pkgdir/usr/share/applications/ludex.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Ludex
GenericName=Game library
Comment=DRM-free game library, launcher and save manager
Exec=ludex
Icon=ludex
Terminal=false
Categories=Game;
Keywords=games;library;launcher;saves;
StartupWMClass=ludex
StartupNotify=true
EOF
  chmod 644 "$pkgdir/usr/share/applications/ludex.desktop"
}
