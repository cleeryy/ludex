# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node
node_modules/
dist/
.pnpm-store/
*.tsbuildinfo

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
apps/desktop/src-tauri/icons/*.png.bak

# Runtime data (repo root only — do not ignore apps/web/src/data)
/data/
# The save-root registry is source data (#146), not runtime state.
!/data/
/data/*
!/data/save-roots.yaml
!/data/save-overrides.yaml
# The compatibility rules database is source data too (#301); its detached
# signature is published next to it.
!/data/compat-rules.toml
!/data/compat-rules.toml.minisig
/media/
/games/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
*.part
.DS_Store
.idea/
.vscode/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/.last-run.json

# Coverage reports (#263)
coverage/
lcov.info

# SBOMs (#263) — generated by CI into dist/, rooted copies are build output
*.cdx.json
.playwright-mcp/

# Python bytecode (the WebKitGTK spike is the only Python in the repo)
__pycache__/
*.pyc
