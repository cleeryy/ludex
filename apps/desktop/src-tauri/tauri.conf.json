{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludex",
  "version": "0.4.0",
  "identifier": "cloud.cleeryy.ludex",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ludex",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0e0d",
        "visible": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; media-src 'self' data: blob: http: https:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "cleeryy",
    "copyright": "Copyright © 2026 cleeryy",
    "category": "Game",
    "shortDescription": "Self-hosted library for DRM-free games",
    "longDescription": "Ludex is a self-hosted game library for DRM-free games. The desktop app installs games from your Ludex server or a local library, launches them, and reports playtime.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "games"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3REYxRjdENkY4NDI1RDgKUldUWUpZUnZmUi9mWjdndnFKc3dvVkJSak9HeWdIYlJDZ0NreVVFRjVwUUZMWXBpRW53RHRoc0MK",
      "endpoints": [
        "https://github.com/cleeryy/ludex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
