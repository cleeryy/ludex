{
  "name": "@ludex/web",
  "private": true,
  "version": "0.4.25",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/i18n.mjs && node scripts/theme.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/i18n.mjs && node scripts/theme.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.reportsDirectory=coverage --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/**/*.test.{ts,tsx}' --coverage.exclude='src/**/*.d.ts'",
    "i18n:check": "node scripts/i18n.mjs",
    "i18n:write": "node scripts/i18n.mjs --write",
    "i18n:strict": "node scripts/i18n.mjs --strict",
    "i18n:coverage": "node scripts/i18n.mjs --coverage",
    "i18n:hardcoded": "node scripts/i18n.mjs --hardcoded",
    "i18n:pseudo": "node scripts/i18n.mjs --pseudo",
    "theme:check": "node scripts/theme.mjs",
    "theme:write": "node scripts/theme.mjs --write",
    "lint": "eslint . --report-unused-disable-directives"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
