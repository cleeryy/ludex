# Ludex configuration example. Copy to `.env` (gitignored) and edit.
# Docker Compose reads this file automatically for ${VARIABLE} interpolation.
#
# Only the variables listed in compose.yaml's `environment:` block are passed
# to the container. To use any other variable from this file, add it there.

# Image used by `docker compose up` (override to pin a version or use a mirror).
LUDEX_IMAGE=ghcr.io/cleeryy/ludex:latest

# Display name in the web UI and API.
LUDEX_SERVER_NAME=Ludex

# IGDB / Twitch application credentials (optional but recommended).
# Create an app at https://dev.twitch.tv/console/apps and copy the client ID
# and secret here. They stay server-side.
LUDEX_IGDB_CLIENT_ID=
LUDEX_IGDB_CLIENT_SECRET=

# Allow the ingest downloader to fetch from private/link-local addresses.
# Keep false unless you intentionally download from your LAN.
LUDEX_INGEST_ALLOW_PRIVATE=false

# Automatic scan interval in seconds. 0 disables periodic scans.
LUDEX_SCAN_INTERVAL_SECONDS=300

# Extra library roots, comma-separated and ordered. LUDEX_GAMES_DIR is always
# the first root and the ingest target. Each extra root needs its own volume.
# LUDEX_LIBRARY_ROOTS=/mnt/retro,/mnt/nas/pc-games

# Watch enabled library roots and trigger a scan after files change.
LUDEX_WATCHER_ENABLED=false
LUDEX_WATCHER_DEBOUNCE_MS=5000

# Scheduled integrity checks, in hours. 0 disables them (default: one week).
LUDEX_INTEGRITY_INTERVAL_HOURS=168

# Media cache garbage collection: minimum orphan age, and an optional schedule.
LUDEX_MEDIA_GC_GRACE_HOURS=24
LUDEX_MEDIA_GC_INTERVAL_HOURS=0

# Game archive storage: local (default) or s3.
LUDEX_STORAGE_BACKEND=local

# S3-compatible object storage (MinIO, Garage, R2, B2, AWS S3). Required when
# LUDEX_STORAGE_BACKEND=s3. Keep the bucket private: downloads are proxied by
# Ludex, never redirected to a signed URL.
# LUDEX_S3_ENDPOINT=https://minio.example.lan:9000
# LUDEX_S3_REGION=us-east-1
# LUDEX_S3_BUCKET=ludex
# LUDEX_S3_ACCESS_KEY=
# LUDEX_S3_SECRET_KEY=
# Path-style addressing is required by MinIO, Garage and most S3 gateways.
# LUDEX_S3_PATH_STYLE=true
# LUDEX_S3_PREFIX=prod

# Optional bearer token for GET /metrics. When unset, /metrics is public but
# limited to 30 scrapes per minute per client IP.
# LUDEX_METRICS_TOKEN=

# Optional commit hash reported by /api/health/details and /metrics.
# LUDEX_GIT_COMMIT=

# Log filter (tracing EnvFilter syntax).
RUST_LOG=ludex_server=info,tower_http=warn

# Optional: fixed JWT signing secret (32+ random bytes, base64/hex/text).
# If unset, Ludex generates one in LUDEX_DATA_DIR on first start. Set this only
# if you need tokens to survive a wiped data directory.
# LUDEX_JWT_SECRET=

# Optional first-run administrator, only used while zero users exist. Prefer
# creating the admin in the web UI; these are for automated deployments.
# LUDEX_ADMIN_USERNAME=
# LUDEX_ADMIN_PASSWORD=

# Advanced overrides. The image sets the path defaults; change the volume
# layout first if you need different values.
# LUDEX_BIND=0.0.0.0:8080
# LUDEX_DATA_DIR=/data
# LUDEX_GAMES_DIR=/games
# LUDEX_MEDIA_DIR=/media
# LUDEX_DATABASE_URL=sqlite:///data/ludex.db?mode=rwc
# LUDEX_WEB_DIR=/app/web
# LUDEX_LOCAL_MODE=false
